{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@testing-library/jest-dom"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true,
    "module": "commonjs"
  },
  "include": [
    "src/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.ts"
  ],
  "exclude": ["node_modules", "build", "dist"]
}
